# Copy to .env (`copy .env.example .env` on Windows) and edit. Never commit .env.
# These are placeholders, not real secrets.

# --- Database ---
# Used when running the backend on your machine (uv run uvicorn ...).
# Inside docker compose, the backend service overrides this to point at the `db` container.
# Port 5433 is the docker compose database (5432 is often taken by a PostgreSQL installed on Windows).
# 127.0.0.1 instead of "localhost": on some Windows PCs "localhost" tries IPv6 first and every
# connection waits ~2 seconds.
DATABASE_URL=postgresql+asyncpg://receiptbox:receiptbox@127.0.0.1:5433/receiptbox
# Used only by `uv run pytest`. The database is created by infra/db/init-test-db.sql.
TEST_DATABASE_URL=postgresql+asyncpg://receiptbox:receiptbox@127.0.0.1:5433/receiptbox_test

# --- Security ---
# Required. Generate a long random value, e.g.:  uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# --- Files ---
STORAGE_ROOT=./storage

# --- AI provider (P05) ---
# "gemini" calls the real model and needs GEMINI_API_KEY (create one in Google AI Studio, keep it
# only in your local .env). "fake" answers from test fixtures and needs no key: handy for demos.
# All tests force "fake"; no test or CI job ever calls a real model.
AI_PROVIDER=gemini
# Model names are settings, not code. Defaults below were checked against the free tier on
# 2026-11-19 (an empty value also means "use this default"). Check Google's current model list
# before changing them.
AI_MODEL_EXTRACT=gemini-3.5-flash-lite
AI_MODEL_ASSISTANT=gemini-3.5-flash-lite
# D-016: free tier only. Real Gemini requests per model and day (Google's day, midnight Pacific);
# keep it a little below the free limit shown on https://ai.dev/rate-limit.
AI_MAX_REQUESTS_PER_DAY=100
GEMINI_API_KEY=
# Seconds the whole extraction call may take, retries included.
AI_TIMEOUT_SECONDS=30
# MINIMAL / LOW / MEDIUM / HIGH for Gemini 3.x models; empty = the model's own default.
# Only Gemini 3.x models accept it (others answer 400). Left empty until measured properly.
AI_THINKING_LEVEL=
# Only used when AI_PROVIDER=fake: where the fixture texts and answers are.
AI_FAKE_FIXTURES_DIR=tests/fixtures/receipts

# --- Matching (P09) ---
# Score thresholds of the receipt <-> bank row matcher (spec 7.4), on a 0-100 scale.
# At or above MATCH_AUTO (and exactly one candidate): merged automatically, with an Undo.
# From MATCH_SUGGEST to MATCH_AUTO: the user is asked. Below: a new purchase.
# Candidates from MATCH_RECORD_MIN are stored with their features for the evaluation (P15).
MATCH_AUTO=95
MATCH_SUGGEST=70
MATCH_RECORD_MIN=50

# --- Logging ---
LOG_LEVEL=INFO

# P12: purchases from this amount (kuruş) in TECHNOLOGY / HOME / CLOTHING are suggested as products.
PRODUCT_SUGGEST_MIN_MINOR=100000
